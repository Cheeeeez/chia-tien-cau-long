# Sao chép thành server/.env rồi sửa: cp server/.env.example server/.env
# Cổng trên máy chủ Docker (trong container luôn là 8787)
HOST_PORT=18787
# Mã truy cập chung của nhóm, tối thiểu 4 ký tự (có thể đơn giản): ai muốn dùng phải nhập mã này trong app.
# Mã ngắn thì dễ đoán nên server khoá IP sau 10 lần nhập sai trong 15 phút; đặt TRUST_PROXY=1 bên dưới để khoá đúng IP thật.
# Đổi mã thì mọi người phải nhập lại mã mới (tài khoản Alobo đã lưu không bị ảnh hưởng).
BOOKING_TOKEN=1234
# Đặt 1 khi máy chủ nằm sau Tailscale Funnel / Cloudflare Tunnel / Caddy / nginx (tin phần tử cuối của X-Forwarded-For do proxy ghi). Để trống nếu mở cổng trực tiếp.
TRUST_PROXY=1
# Khoá mã hoá mật khẩu Alobo đã lưu, >= 16 ký tự (khác với mã truy cập). Sinh: openssl rand -hex 16
# Đổi khoá thì mật khẩu đã lưu không giải mã được nữa, mọi người phải đăng nhập Alobo lại.
SECRET_KEY=doi-thanh-chuoi-bi-mat-khac
# Không bắt buộc: chỉ những SĐT này được đăng nhập (phân tách bằng dấu phẩy). Bỏ trống = SĐT nào có tài khoản Alobo cũng đăng nhập được
# (vẫn phải có mã truy cập và đúng mật khẩu Alobo). Đổi danh sách thì chạy lại `npm run server:up`.
ALLOWED_PHONES=
# Origin của PWA, phân tách bằng dấu phẩy (chỉ origin, không có đường dẫn)
ALLOWED_ORIGIN=https://<user>.github.io,http://localhost:5173
# Số phiên trình duyệt chạy song song; mỗi phiên tốn ~0,5-1 GB RAM. Người đến sau xếp hàng tối đa 45 giây.
MAX_SESSIONS=2
# Không bắt buộc; thiếu thì chỉ dùng được chế độ "Chọn tay"
LLM_API_KEY=fe_oa_xxxxxxxx
LLM_BASE_URL=https://api.freemodel.dev/v1
LLM_MODEL=auto
# Không đặt DATA_DIR khi chạy bằng Docker: image đã trỏ tới volume /data.
# Chạy trực tiếp bằng node thì mặc định lưu ở ./data.
