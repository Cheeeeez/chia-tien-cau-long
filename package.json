{
  "name": "chia-tien-cau-long",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "server:up": "BUILDX_BUILDER=default docker compose -f server/docker-compose.yml up -d --build",
    "server:down": "docker compose -f server/docker-compose.yml down",
    "server:logs": "docker compose -f server/docker-compose.yml logs -f --tail=100"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
